<Window x:Class="WorldClock.AddClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add clock" Width="460" Height="540" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CardBackgroundBrush}" FocusManager.FocusedElement="{Binding ElementName=Search}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Width="80" Padding="0,5" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="OkButton" Content="Add" Width="80" Padding="0,5" IsDefault="True"
                        IsEnabled="False" Click="Ok_Click"/>
            </StackPanel>
            <TextBlock x:Name="ModeLinkText" VerticalAlignment="Center" Margin="0">
                <Hyperlink x:Name="ModeLink" Click="ModeLink_Click">
                    <Run x:Name="ModeLinkRun" Text="Choose time zone manually"/>
                </Hyperlink>
            </TextBlock>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="SearchPrompt" Text="Search for a city"/>
            <TextBox x:Name="Search" TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"/>
            <TextBlock x:Name="Status" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Name="LabelPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Label shown on the clock"/>
            <TextBox x:Name="LabelBox" TextChanged="Label_TextChanged"/>
        </StackPanel>

        <ListBox x:Name="Results" Margin="0,6,0,0" DisplayMemberPath="DisplayName"
                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                 SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_MouseDoubleClick"/>
    </DockPanel>
</Window>
