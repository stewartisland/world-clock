<Window x:Class="WorldClock.AddClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add clock" Width="460" Height="520" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1F232B" FocusManager.FocusedElement="{Binding ElementName=Search}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A909C"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15171C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#2C313B"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Padding="0,5" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="AddButton" Content="Add" Width="80" Padding="0,5" IsDefault="True"
                    IsEnabled="False" Click="Add_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Search time zones (city, country or UTC offset)"/>
            <TextBox x:Name="Search" TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Label shown on the clock"/>
            <TextBox x:Name="LabelBox" TextChanged="Label_TextChanged"/>
        </StackPanel>

        <ListBox x:Name="Zones" Margin="0,10,0,0" DisplayMemberPath="DisplayName"
                 Background="#15171C" Foreground="#E4E7EC" BorderBrush="#2C313B"
                 SelectionChanged="Zones_SelectionChanged" MouseDoubleClick="Zones_MouseDoubleClick"/>
    </DockPanel>
</Window>
