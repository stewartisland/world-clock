<Window x:Class="WorldClock.Sync.SyncChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose your clocks" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource CardBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20">
        <TextBlock Text="Your clocks on this PC are different from the ones saved to your Microsoft account. Which do you want to keep?"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <TextBlock Text="Saved to your account" Style="{StaticResource Heading}"/>
        <TextBlock x:Name="SavedText"/>
        <TextBlock x:Name="SavedDetail" Style="{StaticResource Muted}"/>

        <TextBlock Text="On this PC" Style="{StaticResource Heading}"/>
        <TextBlock x:Name="LocalText"/>

        <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0"
                   Text="The set you don't keep is saved as a backup (clocks.backup.json), so nothing is lost."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Padding="14,5" IsCancel="True" Margin="0,0,8,0" ToolTip="Sign out without changing anything"/>
            <Button Content="Keep this PC's clocks" Padding="14,5" Margin="0,0,8,0" Click="KeepLocal_Click"/>
            <Button Content="Use saved clocks" Padding="14,5" IsDefault="True" Click="UseSaved_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
