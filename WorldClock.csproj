<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WorldClock</AssemblyName>
    <RootNamespace>WorldClock</RootNamespace>
    <!-- Major.Minor. Bump with scripts/bump-version.ps1, not by hand, so CHANGELOG.md stays in step. -->
    <Version>1.2</Version>
    <Copyright>Copyright (c) 2026 Brendon. MIT License.</Copyright>
  </PropertyGroup>

</Project>
