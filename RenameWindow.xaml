<Window x:Class="WorldClock.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename clock" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1F232B" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="16">
        <TextBlock Text="Label shown on the clock" Foreground="#8A909C" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Background="#15171C" Foreground="White" CaretBrush="White"
                 BorderBrush="#2C313B" Padding="6,5" FontSize="14" TextChanged="NameBox_TextChanged"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Padding="0,5" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="Rename" Width="80" Padding="0,5" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
