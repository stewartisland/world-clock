<Window x:Class="WorldClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Clock" Width="780" Height="560" MinWidth="440" MinHeight="320"
        Background="{DynamicResource WindowBackgroundBrush}" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Add clock" Padding="12,6" Style="{StaticResource FlatButton}"
                        Click="AddClock_Click"/>
                <Button x:Name="MoreButton" Content="⋯" Width="32" Height="30" Margin="8,0,0,0" FontSize="16"
                        Style="{StaticResource FlatButton}" ToolTip="More options"
                        AutomationProperties.Name="More options" Click="More_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu" Placement="Custom" Opened="MoreMenu_Opened">
                            <MenuItem Header="Temperature" IsEnabled="False"/>
                            <MenuItem x:Name="CelsiusItem" Header="Celsius (°C)" Click="Celsius_Click"/>
                            <MenuItem x:Name="FahrenheitItem" Header="Fahrenheit (°F)" Click="Fahrenheit_Click"/>
                            <Separator/>
                            <MenuItem Header="Theme" IsEnabled="False"/>
                            <MenuItem x:Name="LightItem" Header="Light" Click="Light_Click"/>
                            <MenuItem x:Name="DarkItem" Header="Dark" Click="Dark_Click"/>
                            <MenuItem x:Name="SystemThemeItem" Header="Use Windows setting" Click="SystemTheme_Click"/>
                            <Separator/>
                            <MenuItem x:Name="TopmostItem" Header="Always on top" Click="Topmost_Click"/>
                            <Separator/>
                            <MenuItem Header="About World Clock" Click="About_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="World Clock" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Drag cards to reorder · right-click for more" Style="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,6,0"
                   Style="{StaticResource Muted}" FontSize="11">
            <Run Text="Weather:"/>
            <Hyperlink NavigateUri="https://open-meteo.com/" RequestNavigate="Hyperlink_RequestNavigate"
                       Foreground="{DynamicResource TextMutedBrush}">Open-Meteo.com</Hyperlink>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Clocks">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ColumnCount, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Margin="6" Padding="18,14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" AllowDrop="True" Cursor="SizeAll"
                                PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                MouseMove="Card_MouseMove" DragOver="Card_DragOver" Drop="Card_Drop">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename…" Click="Rename_Click"/>
                                    <MenuItem Header="Set location…" Click="SetLocation_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Move earlier" Click="MoveEarlier_Click"/>
                                    <MenuItem Header="Move later" Click="MoveLater_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Remove" Click="Remove_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="✕" FontSize="11"
                                            Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                                            Style="{StaticResource FlatButton}" Visibility="Hidden"
                                            ToolTip="Remove clock" Click="Remove_Click"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Icon}" FontSize="18" Foreground="{DynamicResource IconBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding City}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <DockPanel Margin="0,4,0,2">
                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock x:Name="TemperatureText" Text="{Binding Temperature}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Light"
                                                   ToolTip="Current temperature"
                                                   Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button x:Name="SetLocationLink" Content="Set location…" FontSize="12"
                                                Style="{StaticResource LinkButton}" Click="SetLocation_Click"
                                                ToolTip="Choose a place to show weather for"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="38" FontWeight="Light"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Place}" Style="{StaticResource Muted}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                                           Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Offset}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CardBorderHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding HasLocation}" Value="True">
                                <Setter TargetName="SetLocationLink" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWeatherStale}" Value="True">
                                <Setter TargetName="TemperatureText" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="TemperatureText" Property="ToolTip" Value="Couldn't update the weather recently"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
