<Window x:Class="WorldClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Clock" Width="760" Height="520" MinWidth="420" MinHeight="300"
        Background="#15171C" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A909C"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C9CED8"/>
            <Setter Property="Background" Value="#262B34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#343A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="TopmostToggle" VerticalAlignment="Center" Margin="0,0,14,0"
                          Foreground="#8A909C" Content="Always on top"
                          Checked="TopmostToggle_Changed" Unchecked="TopmostToggle_Changed"/>
                <Button Content="+ Add clock" Padding="12,6" Style="{StaticResource FlatButton}"
                        Click="AddClock_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="World Clock" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Drag cards to reorder · right-click for more" Style="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Clocks">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ColumnCount, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Margin="6" Padding="18,14" CornerRadius="10" Background="#1F232B"
                                BorderBrush="#2C313B" BorderThickness="1" AllowDrop="True" Cursor="SizeAll"
                                PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                MouseMove="Card_MouseMove" DragOver="Card_DragOver" Drop="Card_Drop">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Move earlier" Click="MoveEarlier_Click"/>
                                    <MenuItem Header="Move later" Click="MoveLater_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Remove" Click="Remove_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="✕" FontSize="11"
                                            Width="22" Height="22" Margin="8,0,0,0" Padding="0"
                                            Style="{StaticResource FlatButton}" Visibility="Hidden"
                                            ToolTip="Remove clock" Click="Remove_Click"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DayNight}" FontSize="16"/>
                                    <TextBlock Text="{Binding City}" Foreground="White" FontSize="16"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Time}" Foreground="White" FontSize="38"
                                           FontWeight="Light" Margin="0,4,0,2"/>
                                <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Offset}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#3A4150"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#5B8DEF"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
