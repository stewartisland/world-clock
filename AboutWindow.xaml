<Window x:Class="WorldClock.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About World Clock" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource CardBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,4"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20">
        <TextBlock Text="World Clock" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
        <TextBlock Margin="0,12,0,0"
                   Text="The time and weather in the places you care about, at a glance."/>

        <TextBlock Text="Links" Style="{StaticResource Heading}"/>
        <TextBlock>
            <Hyperlink NavigateUri="https://www.brendonford.com/world-clock" RequestNavigate="Link_RequestNavigate">
                Blog: brendonford.com/world-clock</Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,4,0,0">
            <Hyperlink NavigateUri="https://github.com/stewartisland/world-clock" RequestNavigate="Link_RequestNavigate">
                Source code on GitHub</Hyperlink>
        </TextBlock>

        <TextBlock Text="Weather data" Style="{StaticResource Heading}"/>
        <TextBlock>
            <Run Text="Weather and place search are provided by"/>
            <Hyperlink NavigateUri="https://open-meteo.com/" RequestNavigate="Link_RequestNavigate">Open-Meteo.com</Hyperlink><Run Text=", a free, open-source weather API. Thank you!"/>
        </TextBlock>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
            <Run Text="Data licensed under"/>
            <Hyperlink NavigateUri="https://creativecommons.org/licenses/by/4.0/" RequestNavigate="Link_RequestNavigate">CC BY 4.0</Hyperlink><Run Text=". Open-Meteo's free service is for non-commercial use."/>
        </TextBlock>

        <TextBlock Text="License" Style="{StaticResource Heading}"/>
        <TextBlock Style="{StaticResource Muted}">
            <Run x:Name="CopyrightRun"/>
            <Run Text="Released under the"/>
            <Hyperlink NavigateUri="https://github.com/stewartisland/world-clock/blob/main/LICENSE" RequestNavigate="Link_RequestNavigate">MIT License</Hyperlink><Run Text="."/>
        </TextBlock>

        <Button Content="Close" Width="80" Padding="0,5" Margin="0,20,0,0" HorizontalAlignment="Right"
                IsCancel="True" IsDefault="True"/>
    </StackPanel>
</Window>
